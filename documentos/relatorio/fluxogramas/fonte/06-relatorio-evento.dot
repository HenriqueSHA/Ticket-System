  I  [class=term label="Início\nrelatorioEvento(organizador)"]
  R  [class=io   label="Ler idEvento"]
  B  [class=proc label="evento ← buscarEvento(idEvento)"]
  C1 [class=dec  label="evento existe\nE é do\norganizador?"]
  E1 [class=io   label="Erro: evento\nnão encontrado"]
  F1 [class=term label="Fim"]
  Z  [class=proc label="vendidos ← 0   cancelados ← 0\npresentes ← 0   inteiras ← 0\nmeias ← 0   receita ← 0"]
  L  [class=dec  label="existe próxima\nvenda v do\nevento?"]
  C2 [class=dec  label="v.status =\nCANCELADA?"]
  CC [class=proc label="cancelados ←\ncancelados + 1"]
  AC [class=proc label="vendidos ← vendidos + 1\nreceita ← receita + v.valor"]
  C3 [class=dec  label="v.tipo = 1\n(inteira)?"]
  IN [class=proc label="inteiras ←\ninteiras + 1"]
  ME [class=proc label="meias ←\nmeias + 1"]
  C4 [class=dec  label="v.status =\nUTILIZADA?"]
  PR [class=proc label="presentes ←\npresentes + 1"]
  OC [class=proc label="ocupacao ←\nvendidos / capacidade × 100"]
  S  [class=io   label="Exibir vendidos, inteiras, meias,\ncancelados, ocupação (%),\npresentes e receita (R$)"]
  MP [class=sub  label="exibirMapaAssentos()\npara cada setor com assento"]
  F  [class=term label="Fim"]
  P  [class=con  label="P"]
  P2 [class=con  label="P"]

  I -> R -> B -> C1
  C1 -> Z  [label=" Sim" weight=10]
  C1 -> E1 [label="Não"]
  E1 -> F1
  {rank=same; C1; E1; F1}
  Z -> L
  L -> C2 [label=" Sim" weight=10]
  L -> OC [label="Não"]
  {rank=same; L; OC}
  OC -> S -> MP -> F
  C2 -> AC [label=" Não" weight=10]
  C2 -> CC [label="Sim"]
  {rank=same; C2; CC}
  AC -> C3
  C3 -> IN [label="Sim"]
  C3 -> ME [label="Não"]
  IN -> C4
  ME -> C4
  C4 -> PR [label="Sim"]
  C4 -> P  [label="Não"]
  PR -> P
  CC -> P
  P2 -> L [label=" próxima venda"]
  {rank=same; P2; Z}
