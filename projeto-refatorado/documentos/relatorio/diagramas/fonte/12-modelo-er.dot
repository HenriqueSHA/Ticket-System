  graph [rankdir=TB nodesep=0.5 ranksep=0.5]
  node [shape=plain fontsize=10]
  edge [arrowhead=crow arrowtail=tee dir=both fontsize=9]
  usuarios [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#ffffff" color="#2f5fb3"><tr><td bgcolor="#dce9fb"><b>usuarios</b></td></tr><tr><td align="left">🔑 id BIGSERIAL<br align="left"/>nome TEXT<br align="left"/>documento TEXT UNIQUE<br align="left"/>email TEXT UNIQUE<br align="left"/>senha_hash TEXT (Argon2)<br align="left"/>perfil CHECK(CLIENTE|ORGANIZADOR|SUPERADMIN)<br align="left"/></td></tr></table>>]
  organizadores [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#ffffff" color="#2f5fb3"><tr><td bgcolor="#dce9fb"><b>organizadores</b></td></tr><tr><td align="left">🔑 id<br align="left"/>usuario_id FK UNIQUE<br align="left"/>razao_social · contato<br align="left"/>cnpj UNIQUE<br align="left"/>status CHECK(ATIVO|BLOQUEADO)<br align="left"/></td></tr></table>>]
  eventos [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#ffffff" color="#2f5fb3"><tr><td bgcolor="#dce9fb"><b>eventos</b></td></tr><tr><td align="left">🔑 id<br align="left"/>organizador_id FK<br align="left"/>nome · descricao · local<br align="left"/>data DATE · horario TIME<br align="left"/>capacidade CHECK(&gt; 0)<br align="left"/>total_vendido CHECK(0..capacidade)<br align="left"/>permite_cancelamento BOOLEAN<br align="left"/>status CHECK(ABERTO|ENCERRADO)<br align="left"/></td></tr></table>>]
  ingressos [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#ffffff" color="#2f5fb3"><tr><td bgcolor="#dce9fb"><b>ingressos</b> (categorias)</td></tr><tr><td align="left">🔑 id<br align="left"/>evento_id FK<br align="left"/>categoria TEXT<br align="left"/>preco_centavos BIGINT ≥ 0<br align="left"/>quantidade &gt; 0<br align="left"/>disponivel CHECK(0..quantidade)<br align="left"/>com_assento · fileiras · assentos_por_fileira<br align="left"/></td></tr></table>>]
  assentos [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#ffffff" color="#2f5fb3"><tr><td bgcolor="#dce9fb"><b>assentos</b></td></tr><tr><td align="left">🔑 id<br align="left"/>evento_id FK · ingresso_id FK<br align="left"/>setor · fileira · numero<br align="left"/>UNIQUE(ingresso_id, fileira, numero)<br align="left"/>situacao CHECK(LIVRE|OCUPADO)<br align="left"/></td></tr></table>>]
  vendas [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#ffffff" color="#2f5fb3"><tr><td bgcolor="#dce9fb"><b>vendas</b></td></tr><tr><td align="left">🔑 id<br align="left"/>data_compra TIMESTAMP<br align="left"/>valor_centavos BIGINT ≥ 0<br align="left"/>tipo CHECK(INTEIRA|MEIA)<br align="left"/>forma_pagamento CHECK(PIX|CREDITO|DEBITO)<br align="left"/>status CHECK(CONFIRMADA|CANCELADA|UTILIZADA)<br align="left"/>cliente_id FK · ingresso_id FK<br align="left"/>assento_id FK (opcional)<br align="left"/><i>índice único parcial: 1 venda ativa por assento</i><br align="left"/></td></tr></table>>]
  usuarios -> organizadores [label="1 : 1" arrowhead=tee]
  organizadores -> eventos [label="1 : N"]
  eventos -> ingressos [label="1 : N"]
  ingressos -> assentos [label="1 : N"]
  usuarios -> vendas [label="1 : N (cliente)"]
  ingressos -> vendas [label="1 : N"]
  assentos -> vendas [label="1 : 0..1 ativa"]
