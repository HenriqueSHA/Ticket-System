  graph [rankdir=TB nodesep=0.35 ranksep=0.55]
  node [shape=plain fontsize=10]
  edge [fontsize=9 arrowsize=0.7]
  Aplicacao [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#ece3f7" color="#6a3fb5"><tr><td><b>Aplicacao</b> «Facade»</td></tr><tr><td align="left">autenticacao · eventos · vendas<br align="left"/>relatorios · administracao</td></tr></table>>]
  SV [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#fdebc8" color="#e08a1e"><tr><td><b>ServicoVendas</b></td></tr><tr><td align="left">+ preparar(sessao, pedido)<br align="left"/>+ confirmar(sessao, pedido)<br align="left"/>+ cancelar(sessao, id)<br align="left"/>+ remarcar(sessao, id, fileira, nº)<br align="left"/>+ historico(sessao)<br align="left"/></td></tr></table>>]
  SE [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#fdebc8" color="#e08a1e"><tr><td><b>ServicoEventos</b></td></tr><tr><td align="left">+ cadastrar · alterar · remover<br align="left"/>+ adicionar/alterar/remover_categoria<br align="left"/>+ listar_disponiveis · mapa<br align="left"/></td></tr></table>>]
  OUT [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#fdebc8" color="#e08a1e"><tr><td><b>ServicoAutenticacao · ServicoRelatorios<br/>ServicoAdministracao</b></td></tr><tr><td align="left">+ entrar · cadastrar_cliente/organizador<br align="left"/>+ relatorio · registrar_presenca<br align="left"/>+ ativar · bloquear · editar · remover<br align="left"/></td></tr></table>>]
  Evento [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#dce9fb" color="#2f5fb3"><tr><td><b>Evento</b></td></tr><tr><td align="left">- id, organizador_id<br align="left"/>- dados: nome, local, data, horário,<br align="left"/>  capacidade, permite_cancelamento<br align="left"/>- total_vendido · status<br align="left"/></td></tr><tr><td align="left">+ verificar_disponivel_para_venda()<br align="left"/>+ alterar(...) · esta_lotado()<br align="left"/></td></tr></table>>]
  Builder [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#f5f5f5" color="#777777"><tr><td><b>EventoBuilder</b> «Builder»</td></tr><tr><td align="left">+ categoria(c) · construir()</td></tr></table>>]
  Ingresso [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#dce9fb" color="#2f5fb3"><tr><td><b>Ingresso</b> (categoria)</td></tr><tr><td align="left">- categoria · preco: Dinheiro<br align="left"/>- quantidade · disponivel<br align="left"/>- setor: Option&lt;Setor&gt;<br align="left"/></td></tr><tr><td align="left">+ esgotado() · alterar(...)<br align="left"/></td></tr></table>>]
  Mapa [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#dce9fb" color="#2f5fb3"><tr><td><b>MapaAssentos</b></td></tr><tr><td align="left">- matriz: Vec&lt;Vec&lt;Situacao&gt;&gt;<br align="left"/></td></tr><tr><td align="left">+ montar() · linhas() · livres()<br align="left"/></td></tr></table>>]
  Assento [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#dce9fb" color="#2f5fb3"><tr><td><b>Assento</b></td></tr><tr><td align="left">- fileira · numero · situacao<br align="left"/></td></tr><tr><td align="left">+ livre() · rotulo()<br align="left"/></td></tr></table>>]
  Venda [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#dce9fb" color="#2f5fb3"><tr><td><b>Venda</b></td></tr><tr><td align="left">- data_compra · valor · tipo<br align="left"/>- forma_pagamento · status<br align="left"/>- cliente_id · ingresso_id · assento_id<br align="left"/></td></tr><tr><td align="left">+ verificar_cancelamento()<br align="left"/>+ verificar_remarcacao()<br align="left"/>+ verificar_check_in()<br align="left"/></td></tr></table>>]
  Usuario [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#dce9fb" color="#2f5fb3"><tr><td><b>Usuario</b></td></tr><tr><td align="left">- nome · documento · email: Email<br align="left"/>- perfil: Perfil · senha_hash<br align="left"/></td></tr></table>>]
  Org [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#dce9fb" color="#2f5fb3"><tr><td><b>Organizador</b></td></tr><tr><td align="left">- razao_social · cnpj: Cnpj<br align="left"/>- contato · status<br align="left"/></td></tr></table>>]
  Fab [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#f5f5f5" color="#777777"><tr><td><b>FabricaUsuarios</b> «Factory»</td></tr><tr><td align="left">+ criar_cliente · criar_superadmin<br align="left"/>+ criar_login_organizador<br align="left"/></td></tr></table>>]
  PP [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#fbdbe6" color="#c2185b"><tr><td><b>«trait» PoliticaPreco</b> «Strategy»</td></tr><tr><td align="left">+ calcular(preco) · descricao()</td></tr></table>>]
  PI [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#fff" color="#c2185b"><tr><td>PrecoInteira</td></tr></table>>]
  PM [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#fff" color="#c2185b"><tr><td>PrecoMeiaEntrada</td></tr></table>>]
  Repo [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#fbdbe6" color="#c2185b"><tr><td><b>«traits» portas</b> «Repository»</td></tr><tr><td align="left">RepositorioUsuarios · RepositorioOrganizadores<br align="left"/>RepositorioEventos · RepositorioVendas<br align="left"/>HashSenha · Relogio<br align="left"/></td></tr></table>>]
  Pg [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#d9f2d9" color="#2e8b3a"><tr><td><b>Repositorio*Pg</b> (PostgreSQL)</td></tr><tr><td align="left">HashArgon2 · RelogioSistema</td></tr></table>>]
  Mem [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#d9f2d9" color="#2e8b3a"><tr><td><b>RepositoriosMemoria</b> (testes)</td></tr><tr><td align="left">RelogioFixo</td></tr></table>>]
  VO [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#f5f5f5" color="#777777"><tr><td><b>Objetos de valor</b></td></tr><tr><td align="left">Cpf · Cnpj · Email · Dinheiro (centavos)</td></tr></table>>]

