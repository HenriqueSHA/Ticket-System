  I  [class=term label="Início\nremarcarCompra(cliente)"]
  LV [class=sub  label="listarVendas(cliente, CONFIRMADA)"]
  R  [class=io   label="Ler idVenda"]
  B  [class=proc label="venda ← buscarVenda(idVenda)"]
  C1 [class=dec  label="venda existe\nE é do\ncliente?"]
  E1 [class=io   label="Erro: compra\nnão encontrada"]
  F1 [class=term label="Fim"]
  C2 [class=dec  label="status =\nCONFIRMADA?"]
  E2 [class=io   label="Erro: já cancelada\nou utilizada"]
  F2 [class=term label="Fim"]
  C3 [class=dec  label="evento permite\nE data > hoje?"]
  E3 [class=io   label="Erro: evento não\npermite remarcar"]
  F3 [class=term label="Fim"]
  C4 [class=dec  label="compra tem\nassento?"]
  E4 [class=io   label="Erro: sem assento\nmarcado"]
  F4 [class=term label="Fim"]
  M  [class=sub  label="exibirMapa(categoria da venda)"]
  LA [class=io   label="Ler fileira, número"]
  C5 [class=dec  label="assento existe\nE está LIVRE?"]
  E5 [class=io   label="Erro: assento\ninexistente ou vendido"]
  TR [class=proc label="TRANSAÇÃO (tudo ou nada):\nnovo assento ← OCUPADO\nassento antigo ← LIVRE\nvenda.idAssento ← novo.id"]
  OK [class=io   label="Escrever \"Assento trocado\""]
  F  [class=term label="Fim"]

  I -> LV -> R -> B -> C1
  C1 -> C2 [label=" Sim" weight=10]
  C1 -> E1 [label="Não"]
  E1 -> F1
  {rank=same; C1; E1; F1}
  C2 -> C3 [label=" Sim" weight=10]
  C2 -> E2 [label="Não"]
  E2 -> F2
  {rank=same; C2; E2; F2}
  C3 -> C4 [label=" Sim" weight=10]
  C3 -> E3 [label="Não"]
  E3 -> F3
  {rank=same; C3; E3; F3}
  C4 -> M [label=" Sim" weight=10]
  C4 -> E4 [label="Não"]
  E4 -> F4
  {rank=same; C4; E4; F4}
  M -> LA -> C5
  C5 -> TR [label=" Sim" weight=10]
  C5 -> E5 [label="Não"]
  E5 -> LA [label=" escolher outro"]
  {rank=same; C5; E5}
  TR -> OK -> F
