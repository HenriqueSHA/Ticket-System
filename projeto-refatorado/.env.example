# Nome do projeto no Docker, prefixo dos contêineres e volume do banco (mude para rodar
# uma segunda cópia ao lado, ex.: PROJETO=ticket-system-v2, PREFIXO=ingressos-v2)
PROJETO=ticket-system
PREFIXO=ingressos
VOLUME_BANCO=ticket-system-dados
# Copie para .env e ajuste. Em produção, troque POSTGRES_PASSWORD.

# ---- banco de dados ----
POSTGRES_USER=ingressos
POSTGRES_PASSWORD=ingressos
POSTGRES_DB=ingressos
# porta do PostgreSQL na máquina (só 127.0.0.1)
PORTA_BANCO=5433

# ---- dados iniciais (só quando o banco está vazio) ----
# true  = cria usuários, eventos e vendas de demonstração (senhas conhecidas — só para testes!)
# false = produção: cria apenas o SuperAdmin abaixo
DADOS_DEMONSTRACAO=true
ADMIN_NOME=Administrador
ADMIN_CPF=
ADMIN_EMAIL=
ADMIN_SENHA=

# ---- contêineres ----
# porta pública da interface web (front)
PORTA_WEB=3000
# true quando o site estiver atrás de HTTPS (o cookie de login só trafega criptografado)
COOKIE_SEGURO=false
# imagens a usar (padrão: as construídas localmente). No servidor, com as imagens publicadas
# pelo GitHub Actions:  ghcr.io/henriquesha/ticket-system-back:latest  e  ...-front:latest
# IMAGEM_BACK=ghcr.io/henriquesha/ticket-system-back:latest
# IMAGEM_FRONT=ghcr.io/henriquesha/ticket-system-front:latest

# ---- desenvolvimento com `cargo run` (fora dos contêineres) ----
DATABASE_URL=postgres://ingressos:ingressos@localhost:5433/ingressos
ENDERECO_API=127.0.0.1:8080
URL_BACK=http://127.0.0.1:8080
ENDERECO=127.0.0.1:3000
