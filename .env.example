# Copie para .env e ajuste. Em produção, troque POSTGRES_PASSWORD.

# ---- banco de dados (docker compose) ----
POSTGRES_USER=ingressos
POSTGRES_PASSWORD=ingressos
POSTGRES_DB=ingressos
# porta do PostgreSQL na máquina (só 127.0.0.1)
PORTA_BANCO=5433

# ---- aplicação no contêiner ----
# porta pública da interface web
PORTA_WEB=3000
# true quando o site estiver atrás de HTTPS (o cookie de login só trafega criptografado)
COOKIE_SEGURO=false

# ---- desenvolvimento com `cargo run` (fora do contêiner) ----
DATABASE_URL=postgres://ingressos:ingressos@localhost:5433/ingressos
ENDERECO=127.0.0.1:3000
